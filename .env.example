# Existing production app configuration (optional; keep existing values intact).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=

# Separate test web OAuth client for /next-version; no client secret is used.
NEXT_PUBLIC_GOOGLE_READONLY_CLIENT_ID=

# Set to readonly ONLY in the separate test deployment.
# Legacy entry routes redirect to /next-version and Google writes are blocked.
# Leave blank for optional private-record and Slides-comment writes in /next-version.
NEXT_PUBLIC_APP_MODE=

# Separate new-version deployment: show the new login at the homepage.
NEXT_PUBLIC_APP_ENTRY=next
# Public support email for the policy and OAuth review (not a secret).
NEXT_PUBLIC_SUPPORT_EMAIL=
